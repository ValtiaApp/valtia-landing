---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const contactos = [
  { titulo: 'Teléfono', detalle: '+569 85960349', href: 'tel:+56985960349' },
  { titulo: 'Contacto', detalle: 'vpina@valtia.cl', href: 'mailto:vpina@valtia.cl' },
  {
    titulo: 'Linkedin',
    detalle: 'linkedin.com/companyvaltia-chile',
    href: 'https://www.linkedin.com/company/valtia-chile',
  },
];
---

<Layout title="Valtia — ¡Hablemos!">
  <main class="font-tenor min-h-dvh bg-white text-neutral-800">
    <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-6 py-8 md:px-12 md:py-10">
      <header class="animate-fade-up">
        <a href="/" aria-label="Volver al inicio" class="inline-block text-neutral-900">
          <Logo class="h-12 w-auto md:h-16" />
        </a>
      </header>

      <div class="flex flex-1 flex-col justify-center gap-12 py-10 md:gap-16">
        <section class="animate-fade-up text-center" style="animation-delay: 150ms">
          <h1 class="mx-auto text-6xl leading-snug font-normal text-neutral-900 md:text-[9.5rem]">
            ¡Hablemos!
          </h1>
        </section>

        <div class="animate-fade-up grid gap-10 text-center sm:grid-cols-3" style="animation-delay: 300ms">
          {
            contactos.map(({ titulo, detalle, href }) => (
              <div>
                <a
                  href={href}
                  class="text-valtia-deep text-2xl underline underline-offset-4 transition-opacity hover:opacity-70 md:text-3xl"
                >
                  {titulo}
                </a>
                <p class="text-valtia-deep mt-1 text-base md:text-lg">{detalle}</p>
              </div>
            ))
          }
        </div>

        <div class="animate-fade-up mt-4 text-center md:mt-16" style="animation-delay: 450ms">
          <a
            href="/"
            class="inline-block border border-neutral-400 px-8 py-3 text-xs tracking-[0.25em] text-neutral-800 uppercase transition-colors duration-300 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white"
          >
            Volvamos al inicio
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
