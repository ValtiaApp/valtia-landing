---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import SectionNav from '../components/SectionNav.astro';
---

<Layout title="Valtia — ¿Qué buscamos?">
  <main class="bg-valtia-green font-tenor min-h-dvh text-neutral-800">
    <div class="mx-auto flex min-h-dvh max-w-7xl flex-col px-6 py-8 md:px-12 md:py-10 2xl:max-w-[88rem]">
      <header class="animate-fade-up mt-6 md:mt-12">
        <a href="/" aria-label="Volver al inicio" class="inline-block text-neutral-900">
          <Logo class="h-16 w-auto md:h-24" />
        </a>
      </header>

      <div class="flex flex-1 items-start justify-center py-10 md:pt-16">
        <div class="animate-fade-up text-center" style="animation-delay: 150ms">
          <h1 class="text-4xl leading-snug font-normal md:text-6xl md:leading-tight xl:text-7xl 2xl:text-[5rem]">
            <span class="text-neutral-900">Somos el brazo operativo de tu</span><br />
            <span class="text-neutral-700">empresa de investigación</span>
          </h1>
          <p class="mx-auto mt-8 max-w-6xl text-[15px] leading-relaxed text-neutral-900 md:text-[29px]">
            automatizamos procesos para que puedas enfocarte en lo que realmente importa:
            la interpretación, el insight y la creación de valor para tus clientes.
          </p>
        </div>
      </div>

      <SectionNav variant="dark" />
    </div>
  </main>
</Layout>
