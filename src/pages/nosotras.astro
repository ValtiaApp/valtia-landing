---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import SectionNav from '../components/SectionNav.astro';
import fotoValeP from '../assets/Vale-P.png';
import fotoValeR from '../assets/Vale-R.jpeg';

const perfiles = [
  {
    nombre: 'Valentina Piña',
    foto: fotoValeP,
    encuadre: 'object-top origin-top scale-110',
    bio: [
      'Ingeniera Comercial, Universidad Diego Portales',
      'Socia persona Asociación de Investigadores de mercado AIM Chile.',
      'Homenajeada con el premio Greenbook Future List 2026',
    ],
    cita: '“La investigación sin criterio es solo dato. Yo trabajo para que cada hallazgo tenga impacto real."',
  },
  {
    nombre: 'Valentina Rojas',
    foto: fotoValeR,
    bio: [
      'Socióloga, Universidad Central',
      'Diplomado en análisis de datos cuantitativos para la investigación social y Magíster en métodos para la investigación social UDP.',
      'Socia persona Asociación de Investigadores de mercado AIM Chile.',
    ],
    cita: '“Para mí el rigor metodológico no es opcional, es lo que le da valor a cada resultado que entregamos."',
  },
];
---

<Layout title="Valtia — Nosotras">
  <main class="font-tenor min-h-dvh bg-white text-neutral-800">
    <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-6 py-8 md:px-12 md:py-10">
      <header class="animate-fade-up mt-6 flex items-center gap-5 md:mt-12 md:gap-8">
        <a href="/" aria-label="Volver al inicio" class="shrink-0 text-neutral-900">
          <Logo class="h-16 w-auto md:h-24" />
        </a>
        <h1 class="flex-1 text-center text-4xl font-normal text-neutral-900 md:pr-28 md:text-6xl">
          Nosotras
        </h1>
      </header>

      <div class="grid flex-1 content-center gap-14 py-10 md:grid-cols-2 md:gap-10">
        {
          perfiles.map(({ nombre, foto, encuadre = 'object-center', bio, cita }, i) => (
            <article
              class="animate-fade-up mx-auto flex max-w-md flex-col items-center text-center"
              style={`animation-delay: ${150 + i * 150}ms`}
            >
              <div class="aspect-4/5 w-48 overflow-hidden rounded-t-full md:w-56">
                <Image
                  src={foto}
                  alt={`Retrato de ${nombre}`}
                  class={`h-full w-full object-cover grayscale ${encuadre}`}
                  widths={[448, 896]}
                  sizes="28rem"
                />
              </div>
              <h2 class="text-valtia-dark mt-6 text-xl tracking-[0.2em] uppercase md:text-2xl">
                {nombre}
              </h2>
              <div class="mt-3 space-y-0.5 text-sm leading-snug tracking-tight text-neutral-600">
                {bio.map((linea) => (
                  <p>{linea}</p>
                ))}
              </div>
              <p class="mt-6 text-sm leading-snug tracking-tight text-neutral-700">{cita}</p>
            </article>
          ))
        }
      </div>

      <SectionNav variant="dark" />
    </div>
  </main>
</Layout>
