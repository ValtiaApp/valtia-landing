---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const perfiles = [
  {
    nombre: 'Valentina Piña',
    iniciales: 'VP',
    bio: [
      'Ingeniera Comercial, Universidad Diego Portales',
      'Socia persona Asociación de Investigadores de mercado AIM Chile.',
      'Homenajeada con el premio Greenbook Future List 2026',
    ],
    cita: '“La investigación sin criterio es solo dato. Yo trabajo para que cada hallazgo tenga impacto real."',
  },
  {
    nombre: 'Valentina Rojas',
    iniciales: 'VR',
    bio: [
      'Socióloga, Universidad Central',
      'Diplomado en análisis de datos cuantitativos para la investigación social y Magíster en métodos para la investigación social UDP.',
      'Socia persona Asociación de Investigadores de mercado AIM Chile.',
    ],
    cita: '“Para mí el rigor metodológico no es opcional, es lo que le da valor a cada resultado que entregamos."',
  },
];
---

<Layout title="Valtia — Nosotras">
  <main class="min-h-dvh bg-white text-neutral-800">
    <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-6 py-8 md:px-12 md:py-10">
      <header class="animate-fade-up flex items-center gap-5 md:gap-8">
        <a href="/" aria-label="Volver al inicio" class="shrink-0 text-neutral-900">
          <Logo class="h-12 w-auto md:h-16" />
        </a>
        <h1 class="flex-1 text-center font-serif text-4xl font-normal text-neutral-900 md:pr-16 md:text-6xl">
          Nosotras
        </h1>
      </header>

      <div class="grid flex-1 content-center gap-14 py-10 md:grid-cols-2 md:gap-10">
        {
          perfiles.map(({ nombre, iniciales, bio, cita }, i) => (
            <article
              class="animate-fade-up mx-auto flex max-w-md flex-col items-center text-center"
              style={`animation-delay: ${150 + i * 150}ms`}
            >
              {/* Placeholder de foto en arco — reemplazar por <Image> cuando estén los retratos */}
              <div class="flex aspect-4/5 w-48 items-end justify-center overflow-hidden rounded-t-full bg-neutral-200 md:w-56">
                <span class="pb-16 font-serif text-5xl text-neutral-400">{iniciales}</span>
              </div>
              <h2 class="text-valtia-dark mt-6 font-serif text-xl tracking-[0.2em] uppercase md:text-2xl">
                {nombre}
              </h2>
              <div class="mt-3 space-y-0.5 text-sm leading-relaxed text-neutral-600">
                {bio.map((linea) => (
                  <p>{linea}</p>
                ))}
              </div>
              <p class="mt-6 text-sm leading-relaxed text-neutral-700">{cita}</p>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
