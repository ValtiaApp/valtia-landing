---
import { Image } from 'astro:assets';
import heroMark from '../assets/hero-mark.png';
---

<section class="relative overflow-hidden bg-valtia-orange py-[100px]">
  <Image
    src={heroMark}
    alt=""
    class="absolute top-1/2 left-[-90px] z-[1] w-[340px] -translate-y-1/2 opacity-90 max-[820px]:hidden"
  />
  <div class="relative z-[2] mx-auto max-w-[1140px] px-8">
    <div class="flex items-center justify-end gap-[60px] max-[820px]:justify-center">
      <div class="max-w-[460px] max-[820px]:max-w-full max-[820px]:text-center">
        <Image
          src={heroMark}
          alt=""
          class="mx-auto mb-6 hidden w-20 max-[820px]:block"
        />
        <h2 class="mb-[26px] text-[42px] font-extrabold tracking-[-0.5px] text-white">
          ¿Hablemos?
        </h2>
        <div class="mb-8 flex flex-col gap-3 max-[820px]:items-center">
          <a href="mailto:vpina@valtia.cl" class="text-base font-medium text-white/92 hover:underline">
            vpina@valtia.cl
          </a>
          <a href="tel:+56985960349" class="text-base font-medium text-white/92 hover:underline">
            +569 85960349
          </a>
          <span class="text-base font-medium text-white/92">Chile</span>
        </div>
      </div>
    </div>
  </div>
</section>
