---
import { Image } from 'astro:assets';
import isotipoNegro from '../assets/isotipo-negro.png';
import isotipoBlanco from '../assets/isotipo-blanco.png';

// variant: "negro" (default) | "blanco"
const { class: className = 'h-12 w-auto', variant = 'negro' } = Astro.props;
const src = variant === 'blanco' ? isotipoBlanco : isotipoNegro;
---

<Image src={src} alt="Valtia" class={className} densities={[1, 2]} />
