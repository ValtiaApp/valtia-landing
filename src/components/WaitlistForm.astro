---
---

<form id="waitlist-form" class="relative mx-auto flex max-w-[480px] flex-col items-center gap-3">
  <div
    class="flex w-full items-center gap-2 rounded-full border border-white/25 bg-white/16 py-2 pr-2 pl-6 max-[820px]:flex-col max-[820px]:items-stretch max-[820px]:gap-3 max-[820px]:rounded-3xl max-[820px]:p-4"
  >
    <input
      type="email"
      name="email"
      placeholder="Tu correo electrónico"
      required
      class="min-w-0 flex-1 border-none bg-transparent text-[15px] font-medium text-white outline-none placeholder:text-white/65 max-[820px]:py-1.5 max-[820px]:text-center"
    />
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute -left-[9999px] h-px w-px overflow-hidden"
    />
    <button
      type="submit"
      class="rounded-full bg-white px-[22px] py-3.5 text-[14.5px] font-bold whitespace-nowrap text-valtia-purple transition-transform duration-150 hover:-translate-y-px hover:shadow-lg disabled:opacity-70 max-[820px]:w-full"
    >
      Únete a la waitlist
    </button>
  </div>

  <label class="flex items-start gap-2 text-left text-[13px] leading-snug text-white/75">
    <input
      type="checkbox"
      name="consent"
      required
      class="mt-0.5 h-4 w-4 shrink-0 accent-valtia-yellow"
    />
    <span>
      Acepto recibir novedades de Valtia por correo
    </span>
  </label>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#waitlist-form');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    if (data.get('company')) {
      return;
    }

    if (!endpoint) {
      console.error('Falta configurar PUBLIC_WAITLIST_ENDPOINT en .env');
      return;
    }

    if (button) button.disabled = true;

    try {
      await fetch(endpoint, { method: 'POST', mode: 'no-cors', body: data });
    } catch (error) {
      console.error('No se pudo enviar el correo a la waitlist', error);
    }

    if (button) {
      button.disabled = false;
      button.textContent = '¡Listo! Te avisamos pronto';
    }
    form.reset();
  });
</script>
